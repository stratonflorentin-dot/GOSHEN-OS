# PostgreSQL owner connection. Used for auth and schema migrations; keep private.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Least-privilege non-owner connection used for tenant data in production.
# It must point to the same database and branch as DATABASE_URL; only the role differs.
DATABASE_URL_APP=postgresql://goshen_app:PASSWORD@HOST/DATABASE?sslmode=require

# Better Auth signing/encryption secret (generate a strong random value).
BETTER_AUTH_SECRET=

# Canonical public app origin, for example https://your-domain.example.
# Set this to the stable domain users visit, not a per-deployment Vercel URL.
BETTER_AUTH_URL=

# Optional legacy secret fallback. Remove after migrating all deployments to BETTER_AUTH_SECRET.
NEXTAUTH_SECRET=

# Optional outgoing mail configuration. Email verification is currently disabled.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="GOSHEN OS <no-reply@example.com>"

# Weather provider: use "mock" in local development only, or "openweather"
# when OPENWEATHER_API_KEY is available. Production never serves mock weather.
WEATHER_PROVIDER=openweather
OPENWEATHER_API_KEY=

# Public browser key for MapTiler Hybrid satellite imagery. Restrict allowed
# origins/domains in MapTiler Cloud because browser keys are visible to users.
NEXT_PUBLIC_MAPTILER_API_KEY=

# Optional Cesium terrain provider credentials; MapLibre fallback is available.
CESIUM_ION_TOKEN=
CESIUM_TERRAIN_TOKEN=

# Optional unpooled connection for migrations and optional app-role password.
DATABASE_URL_UNPOOLED=
GOSHEN_APP_DB_PASSWORD=
